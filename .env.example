# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bpmpro.com.br
NEXT_PUBLIC_APP_ENV=development

# ── Sentry (erros + performance) ───────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── OpenTelemetry (traces server-side, OTLP/HTTP) ──────
OTEL_SERVICE_NAME=bpmpro-web
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# ── Datadog (RUM + Logs no browser) ────────────────────
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=datadoghq.com

# ── New Relic (Browser agent) ──────────────────────────
NEXT_PUBLIC_NEW_RELIC_ACCOUNT_ID=
NEXT_PUBLIC_NEW_RELIC_APPLICATION_ID=
NEXT_PUBLIC_NEW_RELIC_LICENSE_KEY=
NEXT_PUBLIC_NEW_RELIC_TRUST_KEY=
