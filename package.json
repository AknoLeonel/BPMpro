{
  "name": "bpmpro",
  "version": "0.1.0",
  "private": true,
  "description": "BPM \u2014 Brasil Projetos em Movimento: site institucional",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm knip && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@datadog/browser-logs": "^7.16.0",
    "@datadog/browser-rum": "^7.16.0",
    "@newrelic/browser-agent": "^1.324.0",
    "@opentelemetry/api": "^1.9.1",
    "@sentry/nextjs": "^11.8.0",
    "@vercel/otel": "^2.1.3",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "dependency-cruiser": "^18.6.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
